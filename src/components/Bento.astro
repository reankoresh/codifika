---
import Title from "../components/Title.astro";
import DynamicServices from "../components/DynamicServices.jsx";
import { Globe } from "lucide-astro";
---

<section
  class="min-h-screen bg-transparent text-white p-4 md:p-8 font-sans relative z-10"
>
  <!-- Fondos decorativos -->
  <div
    class="absolute top-[-10%] left-0 w-full max-w-screen h-[500px] bg-indigo-600/20 rounded-full blur-[120px] -z-10 animate-pulse"
  >
  </div>
  <div
    class="absolute bottom-[-10%] right-0 w-full max-w-screen h-[500px] bg-purple-600/15 rounded-full blur-[120px] -z-10"
  >
  </div>

  <div
    class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-6 [perspective:1200px]"
  >
    <!-- Columna Izquierda -->
    <div class="md:col-span-3 flex flex-col gap-6">
      <div
        class="bg-white/[0.03] hover:bg-[rgba(255,230,226,0.5)] backdrop-blur-xl p-8 rounded-[2rem] flex items-center h-80 border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] transition-all hover:scale-[1.03] hover:shadow-pink-500/30"
      >
        <div class="flex flex-col justify-center items-center">
          <Title tag="h4" color="white"
            >Software que Vende, Impacta y Escala.</Title
          >
        </div>
      </div>

      <div
        class="bg-white/[0.02] hover:bg-[rgba(255,249,223,0.5)] backdrop-blur-md p-6 rounded-[2rem] border border-white/5 shadow-xl transition-all flex flex-col items-center gap-6 transition-all hover:scale-[1.03] hover:shadow-yellow-500/30"
      >
        <Title tag="h4" color="white" class="mx-auto text-center"
          >Innovación local, alcance global.</Title
        >
        <div class="grid grid-cols-2 w-7/12 gap-4 mx-auto justify-center">
          <div class="text-center">
            <div
              class="w-12 h-12 bg-gradient-to-br from-[#5623D8] to-[#7B53E2] rounded-full flex items-center justify-center mx-auto mb-2"
            >
              <span class="text-white font-bold">1</span>
            </div>
            <span class="block text-xs text-white/80">CRM</span>
          </div>
          <div class="text-center">
            <div
              class="w-12 h-12 bg-gradient-to-br from-[#5623D8] to-[#7B53E2] rounded-full flex items-center justify-center mx-auto mb-2"
            >
              <span class="text-white font-bold">2</span>
            </div>
            <span class="block text-xs text-white/80">UX</span>
          </div>
          <div class="text-center">
            <div
              class="w-12 h-12 bg-gradient-to-br from-[#5623D8] to-[#7B53E2] rounded-full flex items-center justify-center mx-auto mb-2"
            >
              <span class="text-white font-bold">3</span>
            </div>
            <span class="block text-xs text-white/80">Autor</span>
          </div>
          <div class="text-center">
            <div
              class="w-12 h-12 bg-gradient-to-br from-[#5623D8] to-[#7B53E2] rounded-full flex items-center justify-center mx-auto mb-2"
            >
              <span class="text-white font-bold">4</span>
            </div>
            <span class="block text-xs text-white/80">Datos</span>
          </div>
        </div>
      </div>

      <button
        class="relative group bg-gradient-to-br from-indigo-600 to-purple-700 p-6 rounded-[2rem] overflow-hidden shadow-[0_15px_30px_-5px_rgba(79,70,229,0.5)] transition-all hover:scale-[1.03] hover:shadow-indigo-500/30"
      >
        <div
          class="absolute inset-0 bg-gradient-to-tr from-white/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"
        >
        </div>
        <Title tag="h5" color="white">Haz que tu negocio destaque hoy</Title>
      </button>
    </div>

    <!-- Columna Central -->
    <div class="md:col-span-6 flex flex-col gap-6">
      <div
        class="bg-gradient-to-b from-white/[0.08] to-transparent rounded-[3rem] p-[1px] h-full shadow-2xl"
      >
        <div
          class="bg-[#0f0f15]/90 backdrop-blur-3xl rounded-[3rem] flex flex-col items-center text-center overflow-hidden h-full border border-white/5 relative"
        >
          <div class="mt-12 px-6 relative z-10">
            <span
              class="bg-indigo-500/10 text-indigo-400 px-4 py-1.5 rounded-full text-[10px] font-bold border border-indigo-500/20 uppercase tracking-[0.2em]"
              >Agencia de Desarrollo</span
            >
            <Title
              tag="h2"
              color="white"
              unstyled={true}
              class="text-4xl md:text-5xl font-bold text-white"
            >
              Transformamos tu visión en <br />
              <DynamicServices client:only="react" />
            </Title>
          </div>

          <div class="relative mt-auto w-full flex justify-center py-16">
            <div
              class="absolute w-72 h-72 bg-indigo-500/25 blur-[100px] animate-pulse"
            >
            </div>
            <div
              class="w-56 h-56 bg-gradient-to-tr from-indigo-600 via-purple-500 to-pink-500 rounded-full shadow-[0_0_60px_rgba(79,70,229,0.5)] flex items-center justify-center animate-[bounce_5s_infinite] border-t-2 border-white/40 relative"
            >
              <div
                class="absolute inset-0 rounded-full bg-[radial-gradient(circle_at_30%_30%,rgba(255,255,255,0.2),transparent)]"
              >
              </div>
              <img
                src="/logo-motion.svg"
                alt="Logo animado Codifika"
                class="h-25 w-25 relative z-10"
                draggable="false"
              />
            </div>
          </div>

          <div
            class="grid grid-cols-2 w-full border-t border-white/10 mt-auto bg-white/[0.01]"
          >
            <div
              class="p-8 border-r border-white/10 text-left hover:bg-white/[0.02] transition-colors"
            >
              <Title tag="h5" color="white">Velocidad extrema</Title>
              <p class="text-xs text-gray-500 mt-1">
                +90 en Lighthouse, carga instantánea.
              </p>
            </div>
            <div class="p-8 text-left hover:bg-white/[0.02] transition-colors">
              <Title tag="h5" color="white">Escalabilidad sin límites</Title>
              <p class="text-xs text-gray-500 mt-1">
                Nube, microservicios y evolución continua.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Columna Derecha -->
    <div class="md:col-span-3 flex flex-col gap-6">
      <button
        class="relative group bg-gradient-to-br from-indigo-600 to-purple-700 p-6 rounded-[2rem] overflow-hidden shadow-[0_15px_30px_-5px_rgba(79,70,229,0.5)] transition-all hover:scale-[1.03] hover:shadow-indigo-500/30"
      >
        <div
          class="absolute inset-0 bg-gradient-to-tr from-white/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"
        >
        </div>
        <Title tag="h5" color="white">Inicia y domina tu mercado</Title>
      </button>

      <div
        class="bg-white/[0.03] hover:bg-[rgba(227,248,251,0.5)] backdrop-blur-md p-8 rounded-[2rem] border border-white/10 flex flex-col items-center justify-center h-52 shadow-2xl transition-all hover:scale-[1.03] hover:shadow-sky-500/30"
      >
        <Title tag="h4" color="white"
          >Cambiamos el mundo un línea de código a la vez.</Title
        >
      </div>

      <div
        class="bg-white/[0.02] backdrop-blur-md hover:bg-[rgba(245,230,253,0.5)] p-8 rounded-[3rem] border border-white/5 flex-grow relative overflow-hidden shadow-2xl transition-all hover:scale-[1.03] hover:shadow-purple-500/30"
      >
        <Title tag="h4" color="white" class="mb-5">Especialidades.</Title>
        <div class="flex flex-wrap gap-2 relative z-10">
          {
            [
              "React",
              "NextJS",
              "Tailwind",
              "Astro",
              "Node.js",
              "Express",
              "MongoDB",
              "PostgreSQL",
              "Firebase",
              "Vercel",
              "AWS",
              "Docker",
              "SEO",
              "eCommerce",
              "Stripe",
              "OpenAI",
              "Figma",
              "Three.js",
              "Framer Motion",
              "TypeScript",
            ].map((tech) => (
              <span class="bg-white/5 backdrop-blur-sm text-white/80 px-4 py-1.5 rounded-full text-[10px] border border-white/10 cursor-default transition-all duration-300 hover:bg-gradient-to-r hover:from-[#f967fb] hover:via-[#6958d5] hover:to-[#53bc28] hover:text-white hover:scale-110">
                #{tech}
              </span>
            ))
          }
        </div>
        <div
          class="absolute -bottom-8 -right-8 w-32 h-32 bg-indigo-600/10 rounded-full blur-3xl group-hover:bg-indigo-600/30 transition-all duration-1000"
        >
        </div>
      </div>
    </div>
  </div>
</section>
