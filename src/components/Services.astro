const { servicios = todosLosServicios } = Astro.props as {
  servicios?: Servicio[];
};
---

<section class="w-full flex items-center justify-center px-4 py-16">
  <div class="w-11/12 max-w-6xl grid grid-cols-1 md:grid-cols-3 gap-6">
    {
      servicios.map((servicio: Servicio) => {
        // Asignar icono según el título del servicio
        let icon = undefined;
        switch (servicio.titulo) {
          // web.astro
          case "Diseño responsivo":
            icon = Palette;
            break;
          case "Autoadministrable":
            icon = Briefcase;
            break;
          case "Posicionamiento":
            icon = BarChart2;
            break;
          case "Redes sociales":
            icon = Users;
            break;
          case "Sitio seguro":
            icon = ShieldCheck;
            break;
          case "Correos corporativos":
            icon = MessageCircle;
            break;
          // video.astro
          case "Producción de video":
            icon = Video;
            break;
          case "Postproducción":
            icon = Package;
            break;
          case "Animación 2D y 3D":
            icon = Sparkles;
            break;
          case "Fotografía comercial":
            icon = Camera;
            break;
          case "Videografía con drones":
            icon = Video;
            break;
          case "Voz en off y música":
            icon = Mic;
            break;
          // systems.astro
          case "Aplicaciones web":
            icon = BookOpen;
            break;
          case "Sistemas de comunicación":
            icon = MessageCircle;
            break;
          case "Aplicaciones móviles":
            icon = Package;
            break;
          case "Portales de servicios":
            icon = Building2;
            break;
          case "Sistemas de gestión":
            icon = FileText;
            break;
          case "Integración de sistemas":
            icon = PieChart;
            break;
          // social.astro
          case "Crecimiento de audiencia":
            icon = UserPlus;
            break;
          case "Posicionamiento de marca":
            icon = BarChart2;
            break;
          case "Conversiones y ventas":
            icon = PieChart;
            break;
          case "Creación de contenido":
            icon = FileText;
            break;
          case "Gestión de comunidad":
            icon = MessageCircle;
            break;
          case "Análisis y reportes":
            icon = BarChart2;
            break;
          // drones.astro - servicios extra
          case "Equipamiento profesional":
            icon = Camera;
            break;
          case "Operadores certificados":
            icon = UserCheck;
            break;
          case "Servicio rápido":
            icon = Sparkles;
            break;
          case "Cobertura nacional":
            icon = Globe;
            break;
          case "Flexibilidad":
            icon = Briefcase;
            break;
          case "Postproducción incluida":
            icon = Package;
            break;
          // legacy y otros
          case "Identidad corporativa":
            icon = Palette;
            break;
          case "Material corporativo":
            icon = Briefcase;
            break;
          case "Branding":
            icon = Sparkles;
            break;
          case "Brochures y catálogos":
            icon = BookOpen;
            break;
          case "Publicidad y banners":
            icon = Image;
            break;
          case "Packaging":
            icon = Package;
            break;
          case "Fotografía aérea":
            icon = Camera;
            break;
          case "Avance de obra":
            icon = Building2;
            break;
          case "Cobertura de eventos":
            icon = Users;
            break;
          case "Inspección con drones":
            icon = ShieldCheck;
            break;
          case "Comerciales publicitarios":
            icon = Megaphone;
            break;
          default:
            icon = Sparkles;
        }
        return (
          <Card
            titulo={servicio.titulo}
            descripcion={servicio.descripcion}
            icon={icon}
          />
        );
      })
    }
  </div>
</section>
