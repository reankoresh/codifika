---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Title from "../components/Title.astro";
import Hero from "../components/Hero.astro";
import Contact from "../components/Contact.astro";
import Chooseus from "../components/Chooseus.astro";
import Services from "../components/Services.astro";
---

<Layout title="Diseño Web">
  <div class="bg-black text-white w-full">
    <div class="flex justify-center pt-6">
      <Navbar />
    </div>

    <Hero
      titulo="Diseño web responsivo y orientado a resultados"
      descripcion="Creamos sitios que se adaptan a cualquier dispositivo, autoadministrables, seguros y listos para posicionarse en buscadores."
    />

    <Services
      servicios={[
        {
          titulo: "Diseño responsivo",
          descripcion:
            "Interfaces que se adaptan fluidamente a móviles, tablet y escritorio.",
        },
        {
          titulo: "Autoadministrable",
          descripcion:
            "Capacitación para gestionar contenidos y realizar cambios fácilmente.",
        },
        {
          titulo: "Posicionamiento",
          descripcion:
            "Arquitectura y contenido preparados para SEO y rendimiento.",
        },
        {
          titulo: "Redes sociales",
          descripcion:
            "Integración con tus redes para aumentar alcance y conversión.",
        },
        {
          titulo: "Sitio seguro",
          descripcion:
            "Certificados y prácticas de seguridad para navegación confiable.",
        },
        {
          titulo: "Correos corporativos",
          descripcion: "Correo empresarial personalizado para tu dominio.",
        },
      ]}
    />

    <Chooseus />

    <!-- Servicios adicionales -->
    <section class="w-full flex items-center justify-center px-4 py-16">
      <div class="w-11/12 max-w-6xl">
        <Title
          tag="h2"
          unstyled={true}
          class="text-3xl md:text-4xl font-bold text-white mb-3"
          >Servicios adicionales</Title
        >
        <div
          class="w-32 h-px bg-gradient-to-r from-white/0 via-white/50 to-white/0"
        >
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8">
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Identidad y Logo</Title
            >
            <p class="text-white/70">
              Diseño/rediseño de marca y elementos corporativos.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Material corporativo</Title
            >
            <p class="text-white/70">
              Firmas, hojas membretadas, brochures y tarjetas.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Catálogos y ecommerce</Title
            >
            <p class="text-white/70">
              Catálogo de productos y tiendas en línea.
            </p>
          </div>
        </div>
      </div>
    </section>

    <Contact />

    <Footer />
  </div>
</Layout>
