---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Title from "../components/Title.astro";
---

<Layout title="Diseño Web">
  <div class="bg-black text-white w-full">
    <div class="flex justify-center pt-6">
      <Navbar />
    </div>

    <!-- Hero -->
    <section
      class="min-h-dvh w-full flex items-center justify-center px-4 py-16"
    >
      <div class="w-11/12 max-w-5xl text-center flex flex-col items-center">
        <Title
          tag="h1"
          unstyled={true}
          class="text-4xl md:text-5xl font-bold text-white mb-3"
        >
          Diseño web responsivo y orientado a resultados
        </Title>
        <div
          class="mx-auto w-32 h-px bg-gradient-to-r from-white/0 via-white/50 to-white/0"
        >
        </div>
        <p class="mt-6 text-white/80 max-w-2xl mx-auto">
          Creamos sitios que se adaptan a cualquier dispositivo,
          autoadministrables, seguros y listos para posicionarse en buscadores.
        </p>
      </div>
    </section>

    <!-- Servicios principales -->
    <section class="w-full flex items-center justify-center px-4 py-16">
      <div class="w-11/12 max-w-6xl grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <Title
            tag="h3"
            unstyled={true}
            class="text-xl font-semibold text-white mb-2"
            >Diseño responsivo</Title
          >
          <p class="text-white/70">
            Interfaces que se adaptan fluidamente a móviles, tablet y
            escritorio.
          </p>
        </div>
        <div>
          <Title
            tag="h3"
            unstyled={true}
            class="text-xl font-semibold text-white mb-2"
            >Autoadministrable</Title
          >
          <p class="text-white/70">
            Capacitación para gestionar contenidos y realizar cambios
            fácilmente.
          </p>
        </div>
        <div>
          <Title
            tag="h3"
            unstyled={true}
            class="text-xl font-semibold text-white mb-2">Posicionamiento</Title
          >
          <p class="text-white/70">
            Arquitectura y contenido preparados para SEO y rendimiento.
          </p>
        </div>
        <div>
          <Title
            tag="h3"
            unstyled={true}
            class="text-xl font-semibold text-white mb-2">Redes sociales</Title
          >
          <p class="text-white/70">
            Integración con tus redes para aumentar alcance y conversión.
          </p>
        </div>
        <div>
          <Title
            tag="h3"
            unstyled={true}
            class="text-xl font-semibold text-white mb-2">Sitio seguro</Title
          >
          <p class="text-white/70">
            Certificados y prácticas de seguridad para navegación confiable.
          </p>
        </div>
        <div>
          <Title
            tag="h3"
            unstyled={true}
            class="text-xl font-semibold text-white mb-2"
            >Correos corporativos</Title
          >
          <p class="text-white/70">
            Correo empresarial personalizado para tu dominio.
          </p>
        </div>
      </div>
    </section>

    <!-- Por qué elegirnos -->
    <section class="w-full flex items-center justify-center px-4 py-16">
      <div class="w-11/12 max-w-6xl">
        <Title
          tag="h2"
          unstyled={true}
          class="text-3xl md:text-4xl font-bold text-white mb-3"
          >¿Por qué elegirnos?</Title
        >
        <div
          class="w-32 h-px bg-gradient-to-r from-white/0 via-white/50 to-white/0"
        >
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Tendencias en diseño</Title
            >
            <p class="text-white/70">
              Actualizaciones constantes para conectar con tu mercado meta.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Atención especializada</Title
            >
            <p class="text-white/70">
              Acompañamiento de marketing y diseño durante todo el proyecto.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Soporte técnico</Title
            >
            <p class="text-white/70">
              Infraestructura segura y soporte oportuno.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Cobertura nacional</Title
            >
            <p class="text-white/70">
              Experiencia operando en múltiples ciudades de México y USA.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Servicios adicionales -->
    <section class="w-full flex items-center justify-center px-4 py-16">
      <div class="w-11/12 max-w-6xl">
        <Title
          tag="h2"
          unstyled={true}
          class="text-3xl md:text-4xl font-bold text-white mb-3"
          >Servicios adicionales</Title
        >
        <div
          class="w-32 h-px bg-gradient-to-r from-white/0 via-white/50 to-white/0"
        >
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8">
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Identidad y Logo</Title
            >
            <p class="text-white/70">
              Diseño/rediseño de marca y elementos corporativos.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Material corporativo</Title
            >
            <p class="text-white/70">
              Firmas, hojas membretadas, brochures y tarjetas.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Catálogos y ecommerce</Title
            >
            <p class="text-white/70">
              Catálogo de productos y tiendas en línea.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section class="w-full flex items-center justify-center px-4 py-16">
      <div class="w-11/12 max-w-4xl text-center flex flex-col items-center">
        <Title
          tag="h2"
          unstyled={true}
          class="text-3xl md:text-4xl font-bold text-white mb-3"
          >Contáctanos</Title
        >
        <div
          class="mx-auto w-32 h-px bg-gradient-to-r from-white/0 via-white/50 to-white/0"
        >
        </div>
        <p class="mt-6 text-white/80 max-w-2xl mx-auto">
          Nuestro equipo está listo para asesorarte en tu próximo proyecto.
        </p>
        <div
          class="mt-8 flex flex-col md:flex-row items-center justify-center gap-6 text-white/80"
        >
          <a href="tel:+528131247103" class="hover:text-white transition-colors"
            >Teléfono: +52 (81) 3124 7103</a
          >
          <div class="hidden md:block w-px h-6 bg-white/20"></div>
          <a
            href="mailto:contacto@pixelero.com.mx"
            class="hover:text-white transition-colors"
            >Correo: contacto@pixelero.com.mx</a
          >
          <div class="hidden md:block w-px h-6 bg-white/20"></div>
          <a
            href="https://maps.app.goo.gl/6kUdwEajxXiRkHff6"
            class="hover:text-white transition-colors">Monterrey, NL</a
          >
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Layout>
