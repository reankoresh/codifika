---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Title from "../components/Title.astro";
import Hero from "../components/Hero.astro";
import Contact from "../components/Contact.astro";
import Chooseus from "../components/Chooseus.astro";
import Card from "../components/Card.astro";
import Services from "../components/Services.astro";
---

<Layout title="Renta de Drones">
  <div class="bg-black text-white w-full">
    <div class="flex justify-center pt-6">
      <Navbar />
    </div>

    <Hero
      titulo="Renta de drones y fotografía aérea profesional"
      descripcion="Perspectivas únicas desde el cielo con equipamiento certificado y operadores especializados para tus proyectos."
    />

    <Services
      servicios={[
        {
          titulo: "Fotografía aérea",
          descripcion:
            "Tomas de alta calidad desde perspectiva aérea para proyectos comerciales.",
        },
        {
          titulo: "Videografía con drones",
          descripcion:
            "Video 4K profesional con estabilización de cine para máximo impacto.",
        },
        {
          titulo: "Avance de obra",
          descripcion:
            "Documentación visual precisa y modelos 3D de proyectos constructivos.",
        },
        {
          titulo: "Cobertura de eventos",
          descripcion:
            "Tomas aéreas de celebraciones, conferencias y eventos especiales.",
        },
        {
          titulo: "Inspección con drones",
          descripcion:
            "Análisis visual de infraestructura en áreas difíciles de acceso.",
        },
        {
          titulo: "Comerciales publicitarios",
          descripcion:
            "Videos profesionales con tomas aéreas espectaculares para marketing.",
        },
      ]}
    />

    <Chooseus />

    <!-- Aplicaciones y casos de uso -->
    <section class="w-full flex items-center justify-center px-4 py-16">
      <div class="w-11/12 max-w-6xl">
        <Title
          tag="h2"
          unstyled={true}
          class="text-3xl md:text-4xl font-bold text-white mb-3"
          >Aplicaciones de nuestros servicios</Title
        >
        <div
          class="w-32 h-px bg-gradient-to-r from-white/0 via-white/50 to-white/0"
        >
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Sector inmobiliario</Title
            >
            <p class="text-white/70">
              Presentación de propiedades con vistas espectaculares desde el
              aire.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Construcción y obras</Title
            >
            <p class="text-white/70">
              Monitoreo de avance de proyecto con documentación visual precisa.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Agricultura y terrenos</Title
            >
            <p class="text-white/70">
              Análisis de terrenos y cultivos con perspectiva aérea detallada.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Turismo y hospitalidad</Title
            >
            <p class="text-white/70">
              Promoción de destinos y hoteles con imágenes impactantes desde el
              cielo.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Eventos especiales</Title
            >
            <p class="text-white/70">
              Cobertura aérea de bodas, festivales, conciertos y convenciones.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Publicidad y marketing</Title
            >
            <p class="text-white/70">
              Contenido viral para redes sociales y campañas publicitarias
              impactantes.
            </p>
          </div>
        </div>
      </div>
    </section>

    <Contact />
    tag="h4" unstyled={true}
    class="text-lg font-semibold text-white mb-2">Planeación
  </div>
  <p class="text-white/70">
    Definimos ruta de vuelo, equipo y condiciones operacionales.
  </p>
</Layout>
<div class="text-center">
  <div
    class="w-12 h-12 bg-gradient-to-br from-[#5623D8] to-[#7B53E2] rounded-full flex items-center justify-center mx-auto mb-3"
  >
    <span class="text-white font-bold">3</span>
  </div>
  <Title tag="h4" unstyled={true} class="text-lg font-semibold text-white mb-2"
    >Ejecución</Title
  >
  <p class="text-white/70">
    Captura profesional de tomas aéreas según especificaciones.
  </p>
</div>
<div class="text-center">
  <div
    class="w-12 h-12 bg-gradient-to-br from-[#5623D8] to-[#7B53E2] rounded-full flex items-center justify-center mx-auto mb-3"
  >
    <span class="text-white font-bold">4</span>
  </div>
  <Title tag="h4" unstyled={true} class="text-lg font-semibold text-white mb-2"
    >Entrega</Title
  >
  <p class="text-white/70">
    Material editado y optimizado en formatos solicitados.
  </p>
</div>

<!-- Contacto -->
<section class="w-full flex items-center justify-center px-4 py-16">
  <div class="w-11/12 max-w-4xl text-center flex flex-col items-center">
    <Title
      tag="h2"
      unstyled={true}
      class="text-3xl md:text-4xl font-bold text-white mb-3">Contáctanos</Title
    >
    <div
      class="mx-auto w-32 h-px bg-gradient-to-r from-white/0 via-white/50 to-white/0"
    >
    </div>
    <p class="mt-6 text-white/80 max-w-2xl mx-auto">
      Nuestro equipo está listo para llevar tu proyecto a nuevas alturas.
    </p>
    <div
      class="mt-8 flex flex-col md:flex-row items-center justify-center gap-6 text-white/80"
    >
      <a href="tel:+528131247103" class="hover:text-white transition-colors"
        >Teléfono: +52 (81) 3124 7103</a
      >
      <div class="hidden md:block w-px h-6 bg-white/20"></div>
      <a
        href="mailto:contacto@pixelero.com.mx"
        class="hover:text-white transition-colors"
        >Correo: contacto@pixelero.com.mx</a
      >
      <div class="hidden md:block w-px h-6 bg-white/20"></div>
      <a
        href="https://maps.app.goo.gl/6kUdwEajxXiRkHff6"
        class="hover:text-white transition-colors">Monterrey, NL</a
      >
    </div>
  </div>
</section>

<Footer />
