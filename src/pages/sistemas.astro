---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Title from "../components/Title.astro";
---

<Layout title="Sistemas a la Medida">
  <div class="bg-black text-white w-full">
    <div class="flex justify-center pt-6">
      <Navbar />
    </div>

    <!-- Hero -->
    <section
      class="min-h-dvh w-full flex items-center justify-center px-4 py-16"
    >
      <div class="w-11/12 max-w-5xl text-center flex flex-col items-center">
        <Title
          tag="h1"
          unstyled={true}
          class="text-4xl md:text-5xl font-bold text-white mb-3"
        >
          Desarrollo de sistemas y aplicaciones a la medida
        </Title>
        <div
          class="mx-auto w-32 h-px bg-gradient-to-r from-white/0 via-white/50 to-white/0"
        >
        </div>
        <p class="mt-6 text-white/80 max-w-2xl mx-auto">
          Soluciones tecnológicas personalizadas para transformar tus ideas en
          sistemas funcionales y escalables.
        </p>
      </div>
    </section>

    <!-- Servicios -->
    <section class="w-full flex items-center justify-center px-4 py-16">
      <div class="w-11/12 max-w-6xl grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <Title
            tag="h3"
            unstyled={true}
            class="text-xl font-semibold text-white mb-2"
            >Aplicaciones web</Title
          >
          <p class="text-white/70">
            Plataformas digitales robustas y escalables para gestionar tu
            negocio desde cualquier dispositivo.
          </p>
        </div>
        <div>
          <Title
            tag="h3"
            unstyled={true}
            class="text-xl font-semibold text-white mb-2"
            >Sistemas de comunicación</Title
          >
          <p class="text-white/70">
            Herramientas internas para optimizar la colaboración y comunicación
            entre equipos.
          </p>
        </div>
        <div>
          <Title
            tag="h3"
            unstyled={true}
            class="text-xl font-semibold text-white mb-2"
            >Aplicaciones móviles</Title
          >
          <p class="text-white/70">
            Soluciones nativas e híbridas para iOS y Android que llevan tus
            servicios al bolsillo de tus clientes.
          </p>
        </div>
        <div>
          <Title
            tag="h3"
            unstyled={true}
            class="text-xl font-semibold text-white mb-2"
            >Portales de servicios</Title
          >
          <p class="text-white/70">
            Plataformas en la nube para ofrecer servicios digitales a tus
            clientes con máxima seguridad.
          </p>
        </div>
        <div>
          <Title
            tag="h3"
            unstyled={true}
            class="text-xl font-semibold text-white mb-2"
            >Sistemas de gestión</Title
          >
          <p class="text-white/70">
            Herramientas administrativas personalizadas para controlar
            inventarios, ventas y operaciones.
          </p>
        </div>
        <div>
          <Title
            tag="h3"
            unstyled={true}
            class="text-xl font-semibold text-white mb-2"
            >Integración de sistemas</Title
          >
          <p class="text-white/70">
            Conecta tus herramientas existentes para crear un ecosistema digital
            cohesivo y eficiente.
          </p>
        </div>
      </div>
    </section>

    <!-- Características principales -->
    <section class="w-full flex items-center justify-center px-4 py-16">
      <div class="w-11/12 max-w-6xl">
        <Title
          tag="h2"
          unstyled={true}
          class="text-3xl md:text-4xl font-bold text-white mb-3"
          >Ventajas del desarrollo personalizado</Title
        >
        <div
          class="w-32 h-px bg-gradient-to-r from-white/0 via-white/50 to-white/0"
        >
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8">
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Máxima personalización</Title
            >
            <p class="text-white/70">
              Adaptamos cada funcionalidad exactamente a los requisitos únicos
              de tu negocio.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Facilidad de mantenimiento</Title
            >
            <p class="text-white/70">
              Código limpio y documentado para actualizaciones rápidas y soporte
              continuo.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Posibilidad de ajustes</Title
            >
            <p class="text-white/70">
              Escalabilidad integrada para crecer con tu empresa sin rediseños
              costosos.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Flexibilidad del sistema</Title
            >
            <p class="text-white/70">
              Estructura modular que permite cambios y nuevas funcionalidades
              sin afectar sistemas existentes.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Reducción de gastos fijos</Title
            >
            <p class="text-white/70">
              Paga solo por lo que necesitas, sin costos de licencias
              innecesarias.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Optimización de operaciones</Title
            >
            <p class="text-white/70">
              Automatiza procesos y reduce tiempos operacionales para mayor
              productividad.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Casos de uso -->
    <section class="w-full flex items-center justify-center px-4 py-16">
      <div class="w-11/12 max-w-6xl">
        <Title
          tag="h2"
          unstyled={true}
          class="text-3xl md:text-4xl font-bold text-white mb-3"
          >Casos de uso y aplicaciones</Title
        >
        <div
          class="w-32 h-px bg-gradient-to-r from-white/0 via-white/50 to-white/0"
        >
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Plataformas de cursos en línea</Title
            >
            <p class="text-white/70">
              Educate Pro: plataformas educativas con gestión de contenidos,
              calificaciones y reportes para instituciones.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Bolsas de trabajo especializadas</Title
            >
            <p class="text-white/70">
              Boltra: sistemas de reclutamiento con búsqueda inteligente de
              contenido y recopilación de información laboral.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Sistemas de reporte y análisis</Title
            >
            <p class="text-white/70">
              Herramientas para recopilar, procesar y visualizar datos de ventas
              y marketing en tiempo real.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Aplicaciones de contacto</Title
            >
            <p class="text-white/70">
              Plataformas que conectan empresas con clientes para servicios,
              soporte y comunicación bidireccional.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Portales empresariales</Title
            >
            <p class="text-white/70">
              Ecosistemas internos para colaboración, gestión de proyectos y
              comunicación organizacional.
            </p>
          </div>
          <div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Servicios en la nube</Title
            >
            <p class="text-white/70">
              Aplicaciones SaaS escalables que sirven a múltiples usuarios con
              máxima disponibilidad y seguridad.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Nuestro proceso -->
    <section class="w-full flex items-center justify-center px-4 py-16">
      <div class="w-11/12 max-w-6xl">
        <Title
          tag="h2"
          unstyled={true}
          class="text-3xl md:text-4xl font-bold text-white mb-3"
          >Nuestro proceso de desarrollo</Title
        >
        <div
          class="w-32 h-px bg-gradient-to-r from-white/0 via-white/50 to-white/0"
        >
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mt-8">
          <div class="text-center">
            <div
              class="w-12 h-12 bg-gradient-to-br from-[#5623D8] to-[#7B53E2] rounded-full flex items-center justify-center mx-auto mb-3"
            >
              <span class="text-white font-bold">1</span>
            </div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Análisis de necesidades</Title
            >
            <p class="text-white/70">
              Entendemos tu negocio y definimos requisitos funcionales
              detallados.
            </p>
          </div>
          <div class="text-center">
            <div
              class="w-12 h-12 bg-gradient-to-br from-[#5623D8] to-[#7B53E2] rounded-full flex items-center justify-center mx-auto mb-3"
            >
              <span class="text-white font-bold">2</span>
            </div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Diseño y arquitectura</Title
            >
            <p class="text-white/70">
              Creamos soluciones escalables con tecnologías modernas y mejores
              prácticas.
            </p>
          </div>
          <div class="text-center">
            <div
              class="w-12 h-12 bg-gradient-to-br from-[#5623D8] to-[#7B53E2] rounded-full flex items-center justify-center mx-auto mb-3"
            >
              <span class="text-white font-bold">3</span>
            </div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Desarrollo e implementación</Title
            >
            <p class="text-white/70">
              Construimos tu sistema con código de calidad y pruebas
              exhaustivas.
            </p>
          </div>
          <div class="text-center">
            <div
              class="w-12 h-12 bg-gradient-to-br from-[#5623D8] to-[#7B53E2] rounded-full flex items-center justify-center mx-auto mb-3"
            >
              <span class="text-white font-bold">4</span>
            </div>
            <Title
              tag="h4"
              unstyled={true}
              class="text-lg font-semibold text-white mb-2"
              >Soporte y mantenimiento</Title
            >
            <p class="text-white/70">
              Acompañamiento continuo, actualizaciones y optimizaciones
              post-lanzamiento.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Socios comerciales -->
    <section class="w-full flex items-center justify-center px-4 py-16">
      <div class="w-11/12 max-w-6xl">
        <Title
          tag="h2"
          unstyled={true}
          class="text-3xl md:text-4xl font-bold text-white mb-3"
          >Tu partner digital confiable</Title
        >
        <div
          class="w-32 h-px bg-gradient-to-r from-white/0 via-white/50 to-white/0"
        >
        </div>
        <p class="mt-6 text-white/80 max-w-3xl mx-auto">
          La confianza es la base de un gran producto. Nos esforzamos por
          convertirnos en socios comerciales estratégicos, proporcionando todas
          las soluciones necesarias para lograr objetivos rentables y
          sostenibles para tu negocio. Desde la consultoría inicial hasta el
          soporte posterior al lanzamiento, estamos contigo en cada paso.
        </p>
      </div>
    </section>

    <!-- Contacto -->
    <section class="w-full flex items-center justify-center px-4 py-16">
      <div class="w-11/12 max-w-4xl text-center flex flex-col items-center">
        <Title
          tag="h2"
          unstyled={true}
          class="text-3xl md:text-4xl font-bold text-white mb-3"
          >Solicita una cotización</Title
        >
        <div
          class="mx-auto w-32 h-px bg-gradient-to-r from-white/0 via-white/50 to-white/0"
        >
        </div>
        <p class="mt-6 text-white/80 max-w-2xl mx-auto">
          Contáctanos para discutir tu proyecto y recibir una propuesta
          personalizada.
        </p>
        <div
          class="mt-8 flex flex-col md:flex-row items-center justify-center gap-6 text-white/80"
        >
          <a href="tel:+528131247103" class="hover:text-white transition-colors"
            >Teléfono: +52 (81) 3124 7103</a
          >
          <div class="hidden md:block w-px h-6 bg-white/20"></div>
          <a
            href="mailto:ventas@pixelero.com.mx"
            class="hover:text-white transition-colors"
            >Correo: ventas@pixelero.com.mx</a
          >
          <div class="hidden md:block w-px h-6 bg-white/20"></div>
          <a
            href="https://api.whatsapp.com/send?phone=528131247103"
            class="hover:text-white transition-colors"
            >WhatsApp: +52 (81) 3124 7103</a
          >
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Layout>
