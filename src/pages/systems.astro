---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Chooseus from "../components/Chooseus.astro";
import Contact from "../components/Contact.astro";
---

<Layout title="Sistemas a la Medida">
  <div class="bg-black text-white w-full">
    <div class="flex justify-center pt-6">
      <Navbar />
    </div>

    <Hero
      titulo="Desarrollo de sistemas y aplicaciones a la medida"
      descripcion="Soluciones tecnológicas personalizadas para transformar tus ideas en sistemas funcionales y escalables."
    />

    <Services
      servicios={[
        {
          titulo: "Aplicaciones web",
          descripcion:
            "Plataformas digitales robustas y escalables para gestionar tu negocio desde cualquier dispositivo.",
        },
        {
          titulo: "Sistemas de comunicación",
          descripcion:
            "Herramientas internas para optimizar la colaboración y comunicación entre equipos.",
        },
        {
          titulo: "Aplicaciones móviles",
          descripcion:
            "Soluciones nativas e híbridas para iOS y Android que llevan tus servicios al bolsillo de tus clientes.",
        },
        {
          titulo: "Portales de servicios",
          descripcion:
            "Plataformas en la nube para ofrecer servicios digitales a tus clientes con máxima seguridad.",
        },
        {
          titulo: "Sistemas de gestión",
          descripcion:
            "Herramientas administrativas personalizadas para controlar inventarios, ventas y operaciones.",
        },
        {
          titulo: "Integración de sistemas",
          descripcion:
            "Conecta tus herramientas existentes para crear un ecosistema digital cohesivo y eficiente.",
        },
      ]}
    />

    <Chooseus />
    <Contact />
    <Footer />
  </div>
</Layout>
