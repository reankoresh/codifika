---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Chooseus from "../components/Chooseus.astro";
import Contact from "../components/Contact.astro";
import Services, { todosLosServicios } from "../components/Services.astro";
---

<Layout title="Sistemas a la Medida">
  <div class="bg-black text-white w-full">
    <div class="flex justify-center pt-6">
      <Navbar />
    </div>

    <Hero
      titulo="Desarrollo de sistemas y aplicaciones a la medida"
      descripcion="Soluciones tecnológicas personalizadas para transformar tus ideas en sistemas funcionales y escalables."
    />

    <Services servicios={todosLosServicios.slice(30, 36)} />

    <Chooseus />
    <Contact />
    <Footer />
  </div>
</Layout>
